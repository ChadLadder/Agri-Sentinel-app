# Express Server Port
PORT=3001

# Local Ollama Endpoint (Default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# Hosted Gemma Models Providers (Optional for remote inference)
GROQ_API_KEY=your_groq_api_key_here
HUGGINGFACE_API_KEY=your_hf_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Selected Gemma Model IDs
GEMMA_STRATEGY_MODEL=gemma-2-9b-it
GEMMA_GUARDRAIL_MODEL=gemma-2-2b-it
